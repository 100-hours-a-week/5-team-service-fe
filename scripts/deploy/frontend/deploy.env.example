# Rename this file to deploy.env in the CodeDeploy revision and replace placeholders.
# GitHub Actions production deployment should generate the real deploy.env before creating the revision bundle.

AWS_REGION=ap-northeast-2
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPOSITORY=doktori/frontend-prod
IMAGE_TAG=sha-abcdef0-arm64
CONTAINER_NAME=doktori-frontend
HOST_PORT=3000
CONTAINER_PORT=3000
CONTAINER_STOP_TIMEOUT_SECONDS=30
AWSLOGS_GROUP=/doktori/frontend
AWSLOGS_STREAM_PREFIX=frontend-prod
AWSLOGS_CREATE_GROUP=false
HEALTH_CHECK_PATH=/
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:ap-northeast-2:123456789012:targetgroup/doktori-prod-fe-tg/0123456789abcdef
